# Trading Journal — Environment Variables
# Copy this file to .env in the project root and fill in your keys.
# cp config/.env.example .env

# --- Backend ---
DATABASE_URL=sqlite:///./trading_journal.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# --- Broker API Keys ---

# Alpaca (free stocks/crypto/options)
# Sign up: https://alpaca.markets
# Generate keys: Dashboard > Paper Trading > API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Interactive Brokers (global multi-asset)
# Requires TWS or IB Gateway running locally
# Port: TWS paper=7497, TWS live=7496, Gateway paper=4002, Gateway live=4001
IBKR_HOST=127.0.0.1
IBKR_PORT=7497

# cTrader (free forex/CFD)
# Register: https://connect.spotware.com/apps
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=

# Charles Schwab (US equities/options)
# Enroll: https://developer.schwab.com
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=

# --- AI API Keys ---

# Ollama is local — no key needed
# For Gemini API (optional, has generous free tier):
GEMINI_API_KEY=

# --- Notification ---

# Discord webhook for trade notifications (optional)
DISCORD_WEBHOOK_URL=
